[Unit]
Description=PinkAgc Team Server (self-host profile sync)
After=network.target

[Service]
Type=simple
# Doi User thanh user SSH cua ban (vd: kudols) hoac user rieng
User=pinkagc
WorkingDirectory=/opt/pinkagc-browser
# Bind 127.0.0.1 -> chi Caddy (TLS) proxy vao; khong lo team server ra internet truc tiep
ExecStart=/opt/pinkagc-browser/.venv/bin/python -m core.team_server --host 127.0.0.1 --port 8787 --db /opt/pinkagc-browser/asset/team.db
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
